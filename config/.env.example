
# przykladowa konfiguracja apki Waki

# Port serwera backend
PORT=3000

# Adres API wykorzystywany przez frontend
VITE_API_URL=http://localhost:3000/api

# Adres polaczenia z baza PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/waki

# Srodowisko uruchomieniowe
NODE_ENV=development
